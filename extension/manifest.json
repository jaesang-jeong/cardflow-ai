{
  "manifest_version": 3,
  "name": "CardFlow AI - 기사 카드뉴스 생성기",
  "version": "1.0.0",
  "description": "보고 있는 뉴스 기사 링크를 1초 만에 인스타그램/소셜 미디어 맞춤형 카드뉴스로 자동 요약 및 이미지 배치 생성",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CardFlow AI - 현재 기사로 카드뉴스 제작"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
